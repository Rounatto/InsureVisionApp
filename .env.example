# Core app
DATABASE_URL="postgresql://user:password@host:5432/insurevision"
AUTH_SECRET="replace-with-random-secret"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI provider (optional fallback when MODEL_SERVER_URL is not set)
AI_PROVIDER="http"
AI_ENDPOINT=""
AI_API_KEY=""
AI_TIMEOUT_MS="15000"

# Model server integration (preferred when MODEL_SERVER_URL is set)
MODEL_SERVER_URL="https://insurevision-model-server.onrender.com"
MODEL_API_KEY="replace-with-model-api-secret"
