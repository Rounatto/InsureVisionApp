sequenceDiagram
    autonumber
    actor User
    participant UI as Login Page
    participant NA as NextAuth Handler
    participant DB as Prisma/Postgres
    participant JWT as JWT Session

    User->>UI: Open login page
    User->>UI: Enter email and password

    alt Google login
        UI->>NA: signIn("google")
        NA->>DB: Find or create OAuth user
        DB-->>NA: User record
        NA->>JWT: Build JWT session
        JWT-->>NA: Session token
        NA-->>UI: Success
        UI-->>User: Redirect to /dashboard
    else Email/password login
        UI->>NA: signIn("credentials")
        NA->>NA: Validate input payload
        alt Validation invalid
            NA-->>UI: Validation error
            UI-->>User: Show field errors
        else Validation valid
            NA->>DB: Find user by email
            DB-->>NA: User record
            alt User missing or password missing
                NA-->>UI: Invalid credentials
                UI-->>User: Show login error
            else User found
                NA->>NA: Verify bcrypt password
                alt Password incorrect
                    NA-->>UI: Invalid credentials
                    UI-->>User: Show login error
                else Password correct
                    NA->>JWT: Build JWT session
                    JWT-->>NA: Session token
                    NA-->>UI: Success
                    UI-->>User: Redirect to /dashboard
                end
            end
        end
    end
