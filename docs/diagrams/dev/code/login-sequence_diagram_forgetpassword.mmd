@startuml
actor User
participant "Client App" as Client
participant "Auth API" as API
participant "Rate Limiter" as RL
database "User DB" as DB
participant "Email Service" as ES
database "Reset Token Store" as RTS
database "Session Store" as SS

== Request Reset ==
User -> Client: Click "Forgot Password", enter email
Client -> API: POST /auth/forgot-password
API -> RL: check(ip,email)
RL --> API: allowed
API -> DB: findUserByEmail(email)
DB --> API: user? (maybe null)
API -> API: generateResetToken + expiry
API -> RTS: save(tokenHash, userId, expiry, used=false)
API -> ES: sendResetEmail(email, resetLink)
API --> Client: 200 "If account exists, email sent"

== Perform Reset ==
User -> Client: Open reset link + new password
Client -> API: POST /auth/reset-password (token,newPassword)
API -> RTS: findByTokenHash(tokenHash)
RTS --> API: token record
API -> API: validate(not expired, not used)
alt invalid token
  API --> Client: 400 Invalid/Expired token
else valid token
  API -> DB: updatePasswordHash(userId,newHash)
  API -> RTS: markUsed(tokenId)
  API -> SS: revokeAllSessions(userId)
  API --> Client: 200 Password reset successful
end
@enduml