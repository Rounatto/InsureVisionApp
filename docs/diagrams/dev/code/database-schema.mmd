erDiagram
    User {
        String id PK "cuid()"
        String name "nullable"
        String email UK "unique"
        DateTime emailVerified "nullable"
        String image "nullable"
        String password "nullable (null for OAuth users)"
        Int tokenVersion
        DateTime createdAt "default: now()"
        DateTime updatedAt "auto-updated"
    }

    Account {
        String id PK "cuid()"
        String userId FK
        String provider
        String providerAccountId
        DateTime createdAt "default: now()"
        DateTime updatedAt "auto-updated"
    }

    Session {
        String id PK "cuid()"
        String userId FK
        String sessionToken UK "unique"
        DateTime expires
        DateTime createdAt "default: now()"
        DateTime updatedAt "auto-updated"
    }

    VerificationToken {
        String identifier
        String token
        DateTime expires
    }

    SecurityToken {
        String id PK "cuid()"
        String type
        String hashedToken UK
        String identifier
        DateTime expires
        DateTime createdAt "default: now()"
    }

    AuditLog {
        String id PK "cuid()"
        String userId "nullable"
        String action
        String ip "nullable"
        Json metadata "nullable"
        DateTime createdAt "default: now()"
    }

    Estimate {
        String id PK "cuid()"
        String userId FK
        String summary
        Float totalCost
        DateTime createdAt "default: now()"
    }

    EstimatePart {
        String id PK "cuid()"
        String estimateId FK
        String name
        Float cost
        String severity
    }

    User ||--o{ Account : has
    User ||--o{ Session : has
    User ||--o{ Estimate : owns
    Estimate ||--|{ EstimatePart : contains
