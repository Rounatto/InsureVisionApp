@startuml
autonumber
skinparam shadowing false

actor User
participant "Login Page" as UI
participant "Auth API" as API
database "Database" as DB
participant "JWT Service" as JWT

User -> UI : Enter email and password
UI -> API : POST login request
API -> DB : Check user and password
DB --> API : Result

alt Invalid credentials
    API --> UI : 401 Error
    UI --> User : Show login error
else Valid credentials
    API -> JWT : Create session
    JWT --> API : Session token
    API --> UI : Success
    UI --> User : Redirect to dashboard
end
@enduml