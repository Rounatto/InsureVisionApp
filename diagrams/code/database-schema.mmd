erDiagram
    User {
        String id PK
        String name
        String email
        String image
        String password
        Boolean banned
        DateTime emailVerified
        DateTime createdAt
        DateTime updatedAt
        Int tokenVersion
    }

    Account {
        String id PK
        String userId FK
        String provider
        String providerAccountId
    }

    Session {
        String id PK
        String userId
        String sessionToken
        DateTime expires
    }

    VerificationToken {
        String identifier
        String token
        DateTime expires
    }

    SecurityToken {
        String id PK
        String type
        String hashedToken
        String identifier
        DateTime expires
        DateTime createdAt
    }

    AuditLog {
        String id PK
        String userId
        String action
        String ip
        Json metadata
        DateTime createdAt
    }

    Estimate {
        String id PK
        String userId
        String summary
        Float totalCost
        String[] photos
        DateTime createdAt
    }

    EstimateJob {
        String id PK
        String userId
        String[] photoUrls
        Int photoCount
        EstimateJobStatus status
        Json result
        String error
        DateTime createdAt
        DateTime updatedAt
        DateTime startedAt
        DateTime finishedAt
    }

    EstimatePart {
        String id PK
        String estimateId
        String name
        Float cost
        String severity
    }

    Conversation {
        String id PK
        String bannedUserId
        DateTime createdAt
        DateTime updatedAt
    }

    Message {
        String id PK
        String conversationId
        String senderId
        String senderEmail
        String senderType
        String content
        DateTime createdAt
    }

    AdminMessageRead {
        String id PK
        String messageId
        String adminEmail
        DateTime readAt
    }

    User ||--o{ Account : has
    User ||--o{ Session : has
    User ||--o{ VerificationToken : verifies_with
    User ||--o{ SecurityToken : uses
    User ||--o{ AuditLog : generates
    User ||--o{ Estimate : owns
    User ||--o{ EstimateJob : queues
    User ||--o| Conversation : may_have
    Estimate ||--|{ EstimatePart : contains
    Conversation ||--o{ Message : contains
    Message ||--o{ AdminMessageRead : tracked_by
